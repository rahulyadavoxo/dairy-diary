{
  "name": "dairy-diary",
  "private": true,
  "version": "1.10.39",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug && cd .. && mkdir -p dist-apk && cp android/app/build/outputs/apk/debug/app-debug.apk dist-apk/dairy-diary.apk",
    "test:rules": "bash scripts/rules-test.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "^12.19.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^14.0.3",
    "tinypool": "^2.2.0"
  }
}
